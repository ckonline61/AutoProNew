{
  "name": "auto-pro-mechanic",
  "version": "0.1.0",
  "description": "Auto Pro Mechanic Mobile App",
  "private": true,
  "scripts": {
    "start": "expo start --go --port 8082",
    "android": "expo start --go --android --port 8082",
    "ios": "expo start --go --ios --port 8082",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "expo start --go --clear",
    "web": "expo start --web --port 8082",
    "build": "expo export --platform all",
    "check:expo": "expo install --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "axios": "^1.20.0",
    "expo": "^57.0.28",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "babel-jest": "~29.7.0",
    "babel-preset-expo": "~57.0.15",
    "eslint": "^9.39.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "main": "index.js"
}
