# Auto Pro Backend Environment Variables
# Copy this file to .env and fill in actual values

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
MONGODB_URI=mongodb://localhost:27017/auto-pro-dev

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Add http://YOUR_COMPUTER_LAN_IP:8081 when testing the customer app in a phone browser.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174,http://localhost:8081,http://127.0.0.1:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Razorpay (Phase 11)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Google Maps (Phase 09)
# GOOGLE_MAPS_API_KEY=

# Firebase (Phase 13)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Storage
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Logging
LOG_LEVEL=debug
