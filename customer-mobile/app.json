{
  "expo": {
    "name": "Auto Pro",
    "slug": "auto-pro-customer",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#DC2626"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.autopro.customer",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Auto Pro needs your location to find nearby mechanics and track your service.",
        "NSLocationAlwaysUsageDescription": "Auto Pro needs your location for live tracking during active service.",
        "NSCameraUsageDescription": "Auto Pro needs camera access to upload vehicle photos.",
        "NSPhotoLibraryUsageDescription": "Auto Pro needs photo library access to upload vehicle photos."
      }
    },
    "android": {
      "package": "com.autopro.customer",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DC2626"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Auto Pro to access your location to find nearby mechanics and track your service."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a5c96d22-285d-4e9b-8932-9f74a5c4ba89"
      }
    },
    "owner": "autopro2026"
  }
}
