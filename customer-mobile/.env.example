# Auto Pro Mobile Environment Variables
# Copy to .env and fill in actual values

# API
# Optional override. Use your computer's LAN IP for a physical phone.
# When unset, development uses the Expo server host on port 5000.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:5000/api/v1

# Google Maps (Phase 09)
# GOOGLE_MAPS_API_KEY=
